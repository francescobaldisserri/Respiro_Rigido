<jittershader name="fill-flat-quads-shapes-audio">
	<description>Multi-shape, audio-reactive particle field. Extends the original point-attractor
	shader with several target "shapes" the particles can swarm into: static square outline,
	chaotic noise cloud, rotating circle, rotating figure-eight/infinity symbol, breathing
	spiral/vortex, static straight line, and a rotating wireframe cube. Three audio-band
	uniforms (bass / mid / treble) independently drive attraction strength, rotation speed,
	spiral breathing, turbulence and color.</description>

	<param name="iPosition" type="vec3" state="POSITION" />
	<param name="iColor" type="vec4" state="COLOR" />
	<param name="iVelocity" type="vec4" state="NORMAL" />

	<!-- original controls -->
	<param name="uTarget" type="vec3" default="0.0 0.0 0.0" />
	<param name="uMaxVel" type="float" default="0.04" />
	<param name="uDamp" type="float" default="0.987" />
	<param name="uForceAmt" type="float" default="0.02" />

	<!-- shape controls -->
	<param name="uShapeMode" type="int" default="0" />
	<!-- 0 = classic single-point attractor (original behavior)
	     1 = square (flat outline, fully static/rigid)
	     2 = noise (chaotic volumetric cloud)
	     3 = circle (flat ring, slow rotation)
	     4 = figure-eight / infinity symbol (flat lemniscate, slow rotation)
	     5 = spiral / vortex (flat, radius breathes in/out over time + bass)
	     6 = straight line (fully static/rigid)
	     7 = cube (wireframe edges, slow rotation) -->
	<param name="uShapeBlend" type="float" default="1.0" />
	<param name="uShapeScale" type="float" default="1.2" />
	<param name="uCount" type="float" default="4096.0" />
	<!-- set uCount to the total number of particles (e.g. matrix dim W*H) -->
	<param name="uTime" type="float" default="0.0" />
	<param name="uNoiseAmt" type="float" default="0.15" />

	<!-- audio controls: feed 0..1 band-energy values, e.g. from analyzer~ / jit.catch~ -->
	<param name="uAudioLow" type="float" default="0.0" />
	<param name="uAudioMid" type="float" default="0.0" />
	<param name="uAudioHigh" type="float" default="0.0" />
	<param name="uAudioAmt" type="float" default="1.0" />

	<!-- overall output brightness multiplier -->
	<param name="uBrightness" type="float" default="1.0" />

	<language name="glsl" version="1.5">
		<bind param="iPosition" program="vp" />
		<bind param="iColor" program="vp" />
		<bind param="iVelocity" program="vp" />
		<bind param="uTarget" program="vp" />
		<bind param="uMaxVel" program="vp" />
		<bind param="uDamp" program="vp" />
		<bind param="uForceAmt" program="vp" />
		<bind param="uShapeMode" program="vp" />
		<bind param="uShapeBlend" program="vp" />
		<bind param="uShapeScale" program="vp" />
		<bind param="uCount" program="vp" />
		<bind param="uTime" program="vp" />
		<bind param="uNoiseAmt" program="vp" />
		<bind param="uAudioLow" program="vp" />
		<bind param="uAudioMid" program="vp" />
		<bind param="uAudioHigh" program="vp" />
		<bind param="uAudioAmt" program="vp" />
		<bind param="uBrightness" program="vp" />

		<program name="vp" type="vertex">
<![CDATA[
#version 330 core

uniform vec3  uTarget;
uniform float uMaxVel;
uniform float uDamp;
uniform float uForceAmt;

uniform int   uShapeMode;
uniform float uShapeBlend;
uniform float uShapeScale;
uniform float uCount;
uniform float uTime;
uniform float uNoiseAmt;

uniform float uAudioLow;
uniform float uAudioMid;
uniform float uAudioHigh;
uniform float uAudioAmt;
uniform float uBrightness;

in vec3 iPosition;
in vec3 iVelocity;
in vec4 iColor;

out vec3 oPosition;
out vec3 oVelocity;
out vec4 oColor;

const float PI = 3.14159265359;
const float TAU = 6.28318530718;

// ---------- hashing / noise (cheap, no textures) ----------
float hash11(float p){
	p = fract(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return fract(p);
}
float hash13(vec3 p3){
	p3 = fract(p3 * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}
float vnoise(vec3 x){
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	float n000 = hash13(i + vec3(0.0,0.0,0.0));
	float n100 = hash13(i + vec3(1.0,0.0,0.0));
	float n010 = hash13(i + vec3(0.0,1.0,0.0));
	float n110 = hash13(i + vec3(1.0,1.0,0.0));
	float n001 = hash13(i + vec3(0.0,0.0,1.0));
	float n101 = hash13(i + vec3(1.0,0.0,1.0));
	float n011 = hash13(i + vec3(0.0,1.0,1.0));
	float n111 = hash13(i + vec3(1.0,1.0,1.0));
	float nx00 = mix(n000, n100, f.x);
	float nx10 = mix(n010, n110, f.x);
	float nx01 = mix(n001, n101, f.x);
	float nx11 = mix(n011, n111, f.x);
	float nxy0 = mix(nx00, nx10, f.y);
	float nxy1 = mix(nx01, nx11, f.y);
	return mix(nxy0, nxy1, f.z);
}
vec3 curl(vec3 p){
	float e = 0.15;
	float n1 = vnoise(p + vec3(0.0, e, 0.0));
	float n2 = vnoise(p - vec3(0.0, e, 0.0));
	float n3 = vnoise(p + vec3(0.0, 0.0, e));
	float n4 = vnoise(p - vec3(0.0, 0.0, e));
	float n5 = vnoise(p + vec3(e, 0.0, 0.0));
	float n6 = vnoise(p - vec3(e, 0.0, 0.0));
	float x = (n1 - n2) - (n3 - n4);
	float y = (n3 - n4) - (n5 - n6);
	float z = (n5 - n6) - (n1 - n2);
	return normalize(vec3(x, y, z) + 1e-4);
}

vec3 hsv2rgb(vec3 c){
	vec4 K = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

// ---------- shape library ----------
// each takes a normalized particle id (0..1 across the whole set) plus the raw id/count,
// and returns a point roughly within a unit-ish radius, later multiplied by uShapeScale.

vec2 rot2(vec2 p, float a){
	float c = cos(a), s = sin(a);
	return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
}

// flat square outline, traced evenly around the perimeter. Fully static/rigid:
// no time or audio input touches its geometry, by design, so it reads as "still".
vec3 shapeSquare(float id, float n){
	float t = fract(id / n);
	float side = floor(t * 4.0);
	float f = fract(t * 4.0) * 2.0 - 1.0; // -1..1 position along the current edge
	vec3 p;
	if (side < 0.5)      p = vec3(f, 1.0, 0.0);   // top edge
	else if (side < 1.5) p = vec3(1.0, -f, 0.0);  // right edge
	else if (side < 2.5) p = vec3(-f, -1.0, 0.0); // bottom edge
	else                 p = vec3(-1.0, f, 0.0);  // left edge
	return p;
}

// chaotic volumetric cloud: particles randomly fill a soft sphere-ish volume,
// with a slow internal wobble via noise so the mass never quite settles.
vec3 shapeNoise(float id, float t){
	vec3 dir = normalize(vec3(hash11(id*1.7)-0.5, hash11(id*3.1+7.0)-0.5, hash11(id*5.3+13.0)-0.5) + 1e-4);
	float rnd = hash11(id * 2.3 + 3.0);
	float wobble = vnoise(dir * 2.0 + t * 0.2);
	float radius = mix(0.15, 1.0, rnd) + 0.15 * wobble;
	return dir * radius;
}

// flat ring in the XY plane, slowly spinning around Z (angle passed in).
vec3 shapeCircle(float id, float n, float angle){
	float t = (id / n) * TAU;
	vec2 p = rot2(vec2(cos(t), sin(t)), angle);
	return vec3(p, 0.0);
}

// flat figure-eight / infinity symbol (lemniscate of Bernoulli), lying on its
// side like "∞" — i.e. an "8 rovesciato" — slowly spinning around Z.
vec3 shapeFigureEight(float id, float n, float angle){
	float u = (id / n) * TAU;
	float denom = 1.0 + sin(u) * sin(u);
	vec2 p = vec2(cos(u) / denom, sin(u) * cos(u) / denom);
	p = rot2(p, angle);
	return vec3(p, 0.0);
}

// flat spiral / vortex: winds outward from the center. "pulse" breathes the
// overall radius in and out over time (reinforced by bass), so the shape
// literally advances and recedes rather than just sitting still.
vec3 shapeSpiral(float id, float n, float angleOffset, float pulse){
	float t = id / max(n - 1.0, 1.0);
	float turns = 3.5;
	float ang = t * TAU * turns + angleOffset;
	float r = t * pulse;
	vec2 p = vec2(cos(ang) * r, sin(ang) * r);
	return vec3(p, 0.0);
}

// straight line along X. Fully static/rigid, like the square: the most
// minimal, motionless shape in the set.
vec3 shapeLine(float id, float n){
	float t = (id / max(n - 1.0, 1.0)) * 2.0 - 1.0;
	return vec3(t, 0.0, 0.0);
}

// wireframe cube: particles evenly traverse all 12 edges. A slow rotation
// around Y is applied so its 3D nature reads clearly from a front-on camera
// (otherwise it could look flat like the square from some angles).
vec3 shapeCube(float id, float n, float angle){
	float t = fract(id / n) * 12.0;
	float edge = floor(t);
	float f = fract(t) * 2.0 - 1.0; // -1..1 position along the edge
	float axisF = floor(edge / 4.0);
	float combo = mod(edge, 4.0);
	float c0 = (combo < 2.0) ? -1.0 : 1.0;
	float c1 = (mod(combo, 2.0) < 0.5) ? -1.0 : 1.0;

	vec3 p;
	if (axisF < 0.5)      p = vec3(f, c0, c1);  // x varies
	else if (axisF < 1.5) p = vec3(c0, f, c1);  // y varies
	else                  p = vec3(c0, c1, f);  // z varies

	vec2 xz = rot2(p.xz, angle);
	p.x = xz.x;
	p.z = xz.y;
	return p;
}

void main(){
	float id = float(gl_VertexID);
	float n  = max(uCount, 1.0);
	float audio = uAudioAmt;

	// --- audio-derived modifiers ---
	float energy   = (uAudioLow + uAudioMid + uAudioHigh) / 3.0 * audio;
	float dynForce = uForceAmt * (1.0 + uAudioLow * audio * 2.5);      // bass = pull strength
	float dynDamp  = clamp(uDamp - energy * 0.02, 0.9, 0.999);        // loud = looser/livelier
	float dynMaxVel= uMaxVel * (1.0 + energy * 1.5);
	float twist    = uTime * 0.05 + uAudioMid * audio * 0.6;           // mids = rotation/twist
	float pulse    = 0.65 + 0.35 * sin(uTime * 0.4) + uAudioLow * audio * 0.35; // spiral breathing
	float turb     = uNoiseAmt * (0.3 + uAudioHigh * audio * 1.7);     // treble = turbulence

	// --- pick / blend target shape ---
	vec3 shapePt;
	if (uShapeMode == 1) shapePt = shapeSquare(id, n);
	else if (uShapeMode == 2) shapePt = shapeNoise(id, uTime + twist * 2.0);
	else if (uShapeMode == 3) shapePt = shapeCircle(id, n, twist);
	else if (uShapeMode == 4) shapePt = shapeFigureEight(id, n, twist);
	else if (uShapeMode == 5) shapePt = shapeSpiral(id, n, twist, pulse);
	else if (uShapeMode == 6) shapePt = shapeLine(id, n);
	else if (uShapeMode == 7) shapePt = shapeCube(id, n, twist);
	else shapePt = vec3(0.0); // mode 0 unused, falls back below

	vec3 turbulence = curl(iPosition * 1.5 + uTime * 0.1) * turb;

	vec3 target;
	if (uShapeMode == 0) {
		target = uTarget; // classic single-point attractor, unchanged behavior
	} else {
		vec3 shapeWorld = uTarget + shapePt * uShapeScale + turbulence;
		target = mix(uTarget, shapeWorld, clamp(uShapeBlend, 0.0, 1.0));
	}

	// --- same spring/damp integrator as the original ---
	vec3 dir = target - iPosition;
	vec3 normDir = normalize(dir + 1e-6);
	float dist = length(dir);
	vec3 acc = normDir * dynForce;
	acc /= (dist * 50.0) * (dist * 50.0) + 1.0;
	acc /= max(iColor.x, 0.001);

	oVelocity = iVelocity + acc;
	oVelocity *= dynDamp;
	oVelocity = clamp(oVelocity, vec3(-dynMaxVel), vec3(dynMaxVel));
	oPosition = iPosition + oVelocity;
	oPosition = mod(oPosition + vec3(2.0), vec3(4.0)) - vec3(2.0); // wrap around

	// --- audio-reactive color: hue drifts with mids, brightness pulses with highs ---
	float speed = length(oVelocity);
	float hue = fract(uTime * 0.04 + uAudioMid * audio * 0.5 + id * 0.0006);
	float sat = 0.6 + 0.4 * clamp(uAudioLow * audio, 0.0, 1.0);
	float val = clamp(speed * 40.0 + 0.12 + uAudioHigh * audio * 0.6, 0.0, 1.0);
	vec3 rgb = hsv2rgb(vec3(hue, sat, val)) * max(uBrightness, 0.0);
	float alpha = clamp(uBrightness, 0.0, 1.0); // 0 = completamente invisibile, 1+ = pienamente opaco
	oColor = vec4(clamp(rgb, 0.0, 4.0), alpha);
}
]]>
		</program>
		<program name="fp" type="fragment">
<![CDATA[
#version 330 core
void main() {
}
]]>
		</program>
	</language>
</jittershader>
